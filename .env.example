# ==============================================================================
# TRAFIORA ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development, testing, production)
TRAFIORA_ENV=development

# Internal Metadata Database (PostgreSQL 18.6 with async psycopg3 driver)
# Separate from user databases under test. Defaults to SQLite for zero-config local testing if PG is absent.
TRAFIORA_METADATA_DATABASE_URL=postgresql+psycopg://trafiora_admin:trafiora_dev_password@localhost:5432/trafiora_metadata
TRAFIORA_FALLBACK_SQLITE_URL=sqlite+aiosqlite:///trafiora_local_dev.db

# Security & Secrets Vault (AES-256-GCM Master Key - 32 bytes hex encoded)
TRAFIORA_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TRAFIORA_JWT_SECRET=super_secret_jwt_signing_key_replace_in_prod

# Benchmark Safety & Concurrency Limits
TRAFIORA_MAX_CONCURRENT_BENCHMARKS=2
TRAFIORA_MAX_VUS_PER_BENCHMARK=50
TRAFIORA_MAX_BENCHMARK_DURATION_SECONDS=300
TRAFIORA_ENABLE_DEMO_SIMULATION=true

# Next.js Public Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
